# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# scroll-walk: trabajo de IA (masters, descargas de Flow, fotos fuente). Solo se versionan plan.json y los scripts.
/media/scroll-walk/*
!/media/scroll-walk/plan.json
!/media/scroll-walk/patch_*.py
/_qa/
!/media/scroll-walk/trace_logo.py
